def nav(active: str) -> str:
    links = []
    for href, label in NAV_ITEMS:
        cur = ' aria-current="page"' if href == active else ""
        links.append('<a href="%s"%s>%s</a>' % (href, cur, label))
    return """<header>
  <div class="wrap nav">
    <a class="brand" href="index.html" aria-label="GAMA Decision OS — početna">
      %s
      <span>GAMA Decision OS<small>Agent Control Plane</small></span>
    </a>
    <nav class="navlinks" id="navlinks" aria-label="Glavna navigacija">
      %s
    </nav>
    <div class="navtools">
      <a class="btn primary sm" href="contact.html#demo">Demo</a>
      <button class="burger" id="burger" type="button" aria-label="Meni" aria-expanded="false" aria-controls="navlinks">☰</button>
    </div>
  </div>
</header>""" % (MARK, "\n      ".join(links))


