  async function normalize(raw){
    var s=raw.trim();
    if(s.charAt(0)==='{'){
      var obj;
      try{ obj=JSON.parse(s); }catch(e){ return {err:'JSON nije validan: '+e.message}; }
      var h=await sha256hex(canon(obj));
      if(!h) return {err:'Vaš browser ne podržava Web Crypto; zalijepite receipt_hash direktno.'};
      if(obj.receipt_hash && String(obj.receipt_hash).toLowerCase()!==h){
        msg.innerHTML='<span class="wn">Napomena: receipt_hash u objektu se ne poklapa sa hash-om izračunatim u browseru. Provjeravam onaj iz objekta.</span>';
        return {hash:String(obj.receipt_hash).toLowerCase(), computed:h, obj:obj};
      }
      return {hash:h, computed:h, obj:obj};
    }
    var hex=s.replace(/[^a-fA-F0-9]/g,'').toLowerCase();
    if(hex.length!==64) return {err:'Očekujem 64 heksadecimalna znaka (SHA-256) ili cijeli receipt JSON. Pronašao sam '+hex.length+'.'};
    return {hash:hex};
  }

  function render(data,status){
    var ok=(data&&(data.ok===true||data.verified===true));
    var head=ok?'<span class="ok">DOKAZ POTVRĐEN</span>':'<span class="er">DOKAZ NIJE POTVRĐEN</span>';
    var body=head+'\n';
    body+=line('HTTP',status);
    if(data&&data.receipt_hash) body+=line('receipt_hash',data.receipt_hash);
    if(data&&data.decision_hash) body+=line('decision_hash',data.decision_hash);
    if(data&&typeof data.verified!=='undefined') body+=line('verified',data.verified);
    if(data&&data.reasons&&data.reasons.length) body+=line('reasons',data.reasons.join(', '));
    if(data&&data.err) body+=line('err',data.err);
    if(!data||(!data.receipt_hash&&!data.err&&!data.reasons)){
      body+='\n<span class="dm">'+esc(JSON.stringify(data,null,2).slice(0,1200))+'</span>';
    }
    show(body);
  }

  form.addEventListener('submit',async function(ev){
    ev.preventDefault();
    out.className='result'; out.textContent='';
    msg.textContent='';
    btn.disabled=true; btn.textContent='Provjeravam…';
    try{
      var n=await normalize(input.value||'');
      if(n.err){ show('<span class="wn">'+esc(n.err)+'</span>'); return; }
      show('<span class="dm">hash:</span> '+esc(n.hash)+'\n<span class="dm">tražim verifikator…</span>');
      var attempts=[
        {url:'/api/verify?hash='+encodeURIComponent(n.hash), opts:{headers:{'Accept':'application/json'}}},
        {url:'/gtl/verify', opts:{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:n.hash})}},
        {url:'/gtl/verify', opts:{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({receipt_id:n.hash})}}
      ];
      var lastErr=null;
      for(var i=0;i<attempts.length;i++){
        var a=attempts[i];
        try{
          var r=await fetch(a.url,a.opts);
          if(r.status===404){ lastErr='404 na '+a.url; continue; }
          var txt=await r.text(), data;
          try{ data=JSON.parse(txt); }catch(e){ data={raw:txt.slice(0,800)}; }
          if(r.status===401||r.status===403||r.status===422||r.status===200||r.status===400){
            render(data,r.status); return;
          }
          lastErr='HTTP '+r.status+' na '+a.url;
        }catch(e){ lastErr=e.message; }
      }
      show('<span class="wn">Javni verifikator sa ove adrese nije dostupan.</span>\n'+
           '<span class="dm">Pokušano:</span> '+esc(lastErr||'nema odgovora')+'\n\n'+
           '<span class="dm">Hash koji ste unijeli:</span>\n'+esc(n.hash)+'\n\n'+
           'Pokrenite provjeru lokalno:\n'+
           'curl -sS http://127.0.0.1:7125/gtl/verify \\\n'+
           '  -H "X-Token: $GAMA_TOKEN" -H "Content-Type: application/json" \\\n'+
           '  -d \'{"id":"'+esc(n.hash)+'"}\'\n\n'+
           '<span class="dm">Ako nemate pristup harnessu, pošaljite hash i receipt na info@gamai.io.</span>');
    }catch(e){
      show('<span class="er">Greška pri provjeri: '+esc(e.message)+'</span>');
    }finally{
      btn.disabled=false; btn.textContent='Provjeri';
    }
  });
})();
