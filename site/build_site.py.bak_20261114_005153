def _diagram() -> str:
    W = 84
    C = 1 + W // 2  # kolona vertikalnog konektora

    def top():
        return "+" + "-" * W + "+"

    def row(txt=""):
        return "|" + (" " + txt).ljust(W) + "|"

    def cbot():
        return "+" + "-" * (C - 1) + "+" + "-" * (W - C) + "+"

    lines = [
        "  agent / LLM",
        "      |  tool_call(text, args)",
        "      v",
        top(),
        row("GATE 1 - L0 DECISION"),
        row("  deterministic precheck -> classifier -> calibration T=0.2"),
        row("  out: tier - verdict - risk - confidence - evidence_spec"),
        row("       decision_id + decision_hash (SHA-256)"),
        cbot(),
        " " * C + "|  DecisionEnvelope",
        " " * C + "v",
        top(),
        row("GATE 2 - ROUTING + EXECUTION"),
        row("  READ / DRAFT        -> allow + sandbox by risk"),
        row("  SEND / IRREVERSIBLE -> ask / deny + human approval"),
        row("  hard block: destructive commands, even if model says ok"),
        cbot(),
        " " * C + "v",
        top(),
        row("GATE 3 - EVIDENCE GATE"),
        row("  tool_result -> check against expected_evidence_spec"),
        row("  receipt: sha256(result) + link to decision_hash"),
        row("  verified? -> done   :   rollback / escalation"),
        top(),
    ]
    return "\n" + "\n".join(lines) + "\n      "

DIAGRAM = _diagram()

